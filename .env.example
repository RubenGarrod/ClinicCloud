# ===============================================
# ClinicCloud - Environment Configuration
# ===============================================
#
# IMPORTANTE: Copiar este archivo a .env y configurar
# cp .env.example .env
#
# NUNCA commitear el archivo .env al repositorio
# ===============================================

# ===============================================
# GENERAL
# ===============================================
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO

# ===============================================
# SERVIDOR - Configuración de Red
# ===============================================
# Para LOCAL: usar localhost
# Para PRODUCCIÓN: cambiar a la IP/dominio de tu servidor
SERVER_IP=localhost
SERVER_DOMAIN=localhost

# URL base de la aplicación
APP_URL=http://${SERVER_IP}

# ===============================================
# SEGURIDAD - JWT
# ===============================================
# IMPORTANTE: Generar un secret seguro único
# python3 -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=CAMBIAR_ESTO_POR_UN_SECRET_ALEATORIO_LARGO
JWT_EXPIRE_HOURS=24
JWT_ALGORITHM=HS256
BCRYPT_ROUNDS=12

# ===============================================
# BASE DE DATOS - PostgreSQL
# ===============================================
POSTGRES_USER=cliniccloud
POSTGRES_PASSWORD=CAMBIAR_ESTO_POR_PASSWORD_SEGURO
POSTGRES_DB=cliniccloud

# Variables adicionales para el código Python (usan POSTGRES_* arriba)
DB_USER=${POSTGRES_USER}
DB_PASSWORD=${POSTGRES_PASSWORD}
DB_NAME=${POSTGRES_DB}
DB_HOST=db
DB_PORT=5432

# DATABASE_URL completa (se construye automáticamente)
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${DB_HOST}:${DB_PORT}/${POSTGRES_DB}

# Connection Pool
DB_POOL_MIN_SIZE=5
DB_POOL_MAX_SIZE=20
DB_POOL_MAX_QUERIES=50000
DB_POOL_MAX_INACTIVE_CONN_LIFETIME=300.0

# ===============================================
# REDIS
# ===============================================
REDIS_URL=redis://redis:6379
REDIS_PASSWORD=
RATE_LIMIT_ENABLED=true

# ===============================================
# API REST
# ===============================================
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4

# CORS - Orígenes permitidos
# Para PRODUCCIÓN: cambiar SERVER_IP por tu IP/dominio
# Ejemplo: CORS_ORIGINS=["http://31.220.73.136","http://31.220.73.136:80"]
CORS_ORIGINS=["http://${SERVER_IP}","http://${SERVER_IP}:80","http://${SERVER_IP}:3000"]
CORS_ALLOWED_ORIGINS=http://${SERVER_IP},http://${SERVER_IP}:80,http://${SERVER_IP}:3000
CORS_ALLOW_CREDENTIALS=true

# ===============================================
# FRONTEND
# ===============================================
# Para PRODUCCIÓN: cambiar SERVER_IP por tu IP/dominio del servidor
REACT_APP_API_URL=http://${SERVER_IP}:8000
REACT_APP_SEARCH_ENGINE_URL=http://${SERVER_IP}:8001
REACT_APP_ENVIRONMENT=production

# ===============================================
# MOTOR DE BÚSQUEDA
# ===============================================
SEARCH_ENGINE_HOST=0.0.0.0
SEARCH_ENGINE_PORT=8001
SEARCH_ENGINE_URL=http://search-engine:8001

# Configuración del modelo
MODEL_NAME=pritamdeka/S-PubMedBert-MS-MARCO
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIMENSION=768
MAX_QUERY_LENGTH=512
MAX_SEARCH_RESULTS=20
SIMILARITY_THRESHOLD=0.7

# Caché del modelo (opcional)
MODEL_CACHE_DIR=/app/models

# ===============================================
# SCRAPER - Continuous Mode (Optimized)
# ===============================================
# El scraper corre en modo continuo con control horario y batch processing

# Documentos a procesar por ejecución
SCRAPER_MAX_DOCS=1000

# Tamaño del batch para procesamiento (reduce uso de memoria)
SCRAPER_BATCH_SIZE=25

# Horario de ejecución (formato 24h: 0-23)
SCRAPER_START_HOUR=0
SCRAPER_STOP_HOUR=23

# Tiempo de espera entre ejecuciones (segundos)
# 1800 = 30 minutos, 3600 = 1 hora
SCRAPER_LOOP_DELAY=1800

# ===============================================
# MONITORING & LOGGING
# ===============================================
LOG_FORMAT=json
LOG_FILE_ENABLED=false
LOG_FILE_PATH=/app/logs/cliniccloud.log

# Sentry (opcional)
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1

# ===============================================
# RATE LIMITING
# ===============================================
RATE_LIMIT_AUTH_LOGIN=5/minute
RATE_LIMIT_AUTH_REGISTER=3/hour
RATE_LIMIT_AUTH_RESET_PASSWORD=3/hour
RATE_LIMIT_SEARCH_AUTH=30/minute
RATE_LIMIT_SEARCH_ANON=10/minute
RATE_LIMIT_FAVORITES=50/minute

# ===============================================
# EMAIL (opcional - para notificaciones)
# ===============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_email@gmail.com
SMTP_PASSWORD=tu_app_password
SMTP_FROM=noreply@cliniccloud.com
SMTP_TLS=true

# ===============================================
# BACKUPS (opcional)
# ===============================================
BACKUP_ENABLED=true
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=30
BACKUP_PATH=/backups

# S3 para backups remotos (opcional)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BACKUP_BUCKET=cliniccloud-backups
AWS_REGION=us-east-1

# ===============================================
# HTTPS/SSL (producción)
# ===============================================
SSL_ENABLED=false
SSL_CERT_PATH=/etc/ssl/certs/cliniccloud.crt
SSL_KEY_PATH=/etc/ssl/private/cliniccloud.key

# Let's Encrypt
LETSENCRYPT_EMAIL=admin@tudominio.com
LETSENCRYPT_DOMAIN=tudominio.com

# ===============================================
# DESARROLLO (solo para development)
# ===============================================
# Descomentar solo en ambiente de desarrollo
# DEVELOPMENT_MODE=true
# HOT_RELOAD=true
# ADMINER_ENABLED=true

# ===============================================
# EJEMPLOS DE CONFIGURACIÓN
# ===============================================
#
# DESARROLLO LOCAL:
#   SERVER_IP=localhost
#   CORS_ORIGINS=["http://localhost","http://localhost:80"]
#
# PRODUCCIÓN (Contabo u otro servidor):
#   SERVER_IP=31.220.73.136
#   CORS_ORIGINS=["http://31.220.73.136","http://31.220.73.136:80"]
#
# PRODUCCIÓN con DOMINIO:
#   SERVER_DOMAIN=cliniccloud.tudominio.com
#   APP_URL=https://${SERVER_DOMAIN}
#   CORS_ORIGINS=["https://${SERVER_DOMAIN}"]
#
